# URL base de la API de PrioMed (sin barra final).
VITE_API_URL=http://localhost:8000
# "true" simula la API con MSW en el navegador; "false" usa la API real.
# Si se omite, MSW se activa solo en desarrollo.
VITE_USE_MOCKS=true
# Modo mixto: con VITE_USE_MOCKS=true, "false" envía POST /classify al servicio
# real en VITE_API_URL y deja simulados los demás endpoints.
VITE_MOCK_CLASSIFY=true
